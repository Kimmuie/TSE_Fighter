@startuml 3_scenes_and_ui
title TSE Fighter — Scenes & UI (main.py / ui.py)
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

abstract class Scene {
  + game : Game
  + {abstract} handle_event(event)
  + update(dt)
  + {abstract} draw(surface)
}
class MenuScene {
  - _t : float
}
class SelectScene {
  - _cursor : list[int]
  - _ready : list[bool]
  - _countdown : float
  - _previews : dict
  + grid : RosterGrid
  + cards : tuple[FighterCard]
  - _preview(player) : Fighter
}
class BattleScene {
  + INTRO_TIME, END_TIME
  + phase : str
  + time_left : float
  + round_no : int
  + wins : list[int]
  - _start_round()
  - _end_round(banner, winner)
  - _on_hit() / _on_skill_cast() / _on_ko()
}
class GameOverScene {
  + winner : int
}
class Stage {
  + rect : Rect
  + NAME : str
  + draw(surface)
}
class Game {
  + screen, clock
  + running : bool
  + controllers : tuple[InputController]
  + scene : Scene
  + change_scene(scene)
  + run()
}

class HUD {
  + update(dt, f1, f2)
  + draw(surface, f1, f2, time_left, round_no, wins, arena_name)
}
class HealthBar {
  + ratio : float
  + align_right : bool
  + update(dt) / draw(surface)
}
class SkillBar {
  + draw(surface, fighter)
}
class ComboBanner {
  + CLASH_WINDOW, DISPLAY_TIME
  + on_hit(attacker, damage, hit)
  + update(dt) / draw(surface)
}
class FighterCard {
  + draw(surface, name, title, preview, ready, portrait_path)
}
class RosterGrid {
  + cell(i) : Rect
  + draw(surface, cursors, ready)
}

class EventDispatcher
class BattleWorld
class Fighter
class InputController
class HitInfo

Scene <|-- MenuScene
Scene <|-- SelectScene
Scene <|-- BattleScene
Scene <|-- GameOverScene

Game o-- "1" Scene : current
Game *-- "2" InputController
Scene --> Game
MenuScene ..> SelectScene : change_scene
SelectScene ..> BattleScene : change_scene
BattleScene ..> GameOverScene : change_scene
GameOverScene ..> BattleScene : rematch
GameOverScene ..> SelectScene
GameOverScene ..> MenuScene

SelectScene *-- RosterGrid
SelectScene *-- "2" FighterCard
SelectScene ..> Fighter : preview

BattleScene *-- BattleWorld
BattleScene *-- Stage
BattleScene *-- HUD
BattleScene *-- ComboBanner
BattleScene *-- EventDispatcher
BattleScene o-- "2" Fighter

HUD *-- "2" HealthBar
HUD *-- "2" SkillBar
SkillBar ..> Fighter
ComboBanner ..> HitInfo
EventDispatcher ..> BattleScene : on_hit / on_ko / on_skill_cast
EventDispatcher ..> ComboBanner : on_hit
@enduml
