abstract class BaseSkill {
  + NAME, DESCRIPTION, COOLDOWN, ENERGY_COST, ICON
  + SHEET_PATH, SHEET_TIME, SHEET_COLUMNS
  + key_label : str
  - _cooldown_left : float
  - _frames : list[Surface]
  - _timers : list[dict]
  + cooldown_left, cooldown_ratio
  + bind(key_label)
  + load_sprite()
  + play_pose(caster, pose, length)
  + start_timer(delay, callback, key)
  + cancel_timers(key)
  + can_cast(caster) : bool
  + try_cast(caster, target) : bool
  + update(dt) / reset()
  + on_jump(caster) : bool
  + {abstract} execute(caster, target)
}

Fighter "1" *-- "3" BaseSkill : skills

