@startuml 1_core_architecture
title TSE Fighter — Core Architecture (entities / combat / events / component)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #333333
}
hide empty members

package "events.py" #F3F3F3 {
  class EventDispatcher {
    - _listeners : dict[str, list[Listener]]
    + subscribe(event_name, listener)
    + emit(event_name, **payload)
  }
  class HitInfo {
    + attacker : Fighter
    + damage : float
    + knockback : Vector2
    + direction : int
    + unblockable : bool
    + stun : float
    + tags : frozenset[str]
  }
}

package "component.py" #F3F3F3 {
  enum State {
    IDLE
    WALK
    JUMP
    ATTACK
    CAST
    HIT
    KO
  }
  class StateMachine {
    - _state : State
    - _lock : float
    + state : State {readOnly}
    + can_act : bool {readOnly}
    + change(new_state, lock)
    + locomote(new_state)
    + update(dt)
  }
  class Hitbox {
    - _p : dict
    - _timer : float
    - _has_hit : bool
    + is_active : bool {readOnly}
    + arm(damage, width, height, offset_x, offset_y, windup, active, ...)
    + clear()
    + update(dt)
    + mark_hit()
    + rect_for(owner) : Rect
    + build_hit(owner) : HitInfo
  }
  class InputController {
    - _keymap : dict[str, tuple[int]]
    - _labels : dict[str, str]
    + label(action) : str
    + action_for_event(event) : str
    + is_held(action, pressed) : bool
  }
}

package "entities.py" #F3F3F3 {
  abstract class GameObject {
    + pos : Vector2
    + vel : Vector2
    + gravity : float
    + on_ground : bool
    + rect : Rect
    + set_x(x)
    + update(dt)
    + {abstract} draw(surface)
  }
  class Particle
  class FloatingText
  class SmokeScreen
  class Projectile {
    + owner : Fighter
    + damage : float
    + KNOCKBACK : tuple
    + STUN : float
    + build_hit() : HitInfo
    + on_hit(target)
  }
  abstract class Fighter {
    + NAME / TITLE / BASE_STATS
    + PLAYABLE : bool
    + color, tag, facing : int
    + input_enabled : bool
    + hp, energy, stamina : float
    + skills : list[BaseSkill]
    + opponent : Fighter
    + world : BattleWorld
    + {abstract} create_skills() : list[BaseSkill]
    + handle_event(event)
    + perform(action)
    + basic_attack()
    + take_hit(hit : HitInfo) : bool
    + add_status() / has_status() / remove_status()
    + modify_incoming_damage() / outgoing_damage_multiplier()
    + play_pose() / burst() / reset()
    + update(dt) / draw(surface)
  }
}

package "combat.py" #F3F3F3 {
  class CollisionEngine {
    + resolve(fighters, projectiles)
    - _melee()
    - _projectiles()
    - _separate()
  }
  class BattleWorld {
    + fighters : Group
    + projectiles : Group
    + effects : Group
    + add_fighter(fighter)
    + spawn_projectile(proj)
    + spawn_effect(effect)
    + spawn_particles(...)
    + update(dt) / draw(surface)
  }
}

class "pygame.sprite.Sprite" as Sprite <<external>>

Sprite <|-- GameObject
GameObject <|-- Particle
GameObject <|-- FloatingText
GameObject <|-- SmokeScreen
GameObject <|-- Projectile
GameObject <|-- Fighter

Fighter *-- "1" StateMachine
Fighter *-- "1" Hitbox
Fighter o-- "1" InputController
Fighter o-- "1" EventDispatcher : emits on_hit / on_ko
Fighter "1" -- "1" Fighter : opponent
Fighter --> BattleWorld : world
StateMachine ..> State
Hitbox ..> HitInfo : creates
Projectile ..> HitInfo : creates
Fighter ..> HitInfo : take_hit()
Projectile --> Fighter : owner

BattleWorld *-- CollisionEngine
BattleWorld o-- "2" Fighter
BattleWorld o-- "*" Projectile
BattleWorld o-- "*" GameObject : effects
BattleWorld o-- EventDispatcher
CollisionEngine ..> Fighter
CollisionEngine ..> Projectile
@enduml


